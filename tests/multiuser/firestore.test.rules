rules_version = '2';

// Laundry Queue — Firestore security rules, as tested by tests/multiuser.
// This is a copy of the production rules (Firebase console → Firestore Database → Rules)
// with ONE difference: the admin email below is the test address admin@example.com.
// The production copy has the owner's Gmail there instead. Keep the two in sync:
// change this file, run the multi-user test, then give the owner the full text to paste.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Production: the owner's Gmail. Tests: admin@example.com.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'admin@example.com'
        && request.auth.token.email_verified == true;
    }

    function bookingPath(id) { return /databases/$(database)/documents/bookings/$(id); }
    function dailyPath(id)   { return /databases/$(database)/documents/daily/$(id); }
    function tickPath(id)    { return /databases/$(database)/documents/ticks/$(id); }
    function memberPath(id)  { return /databases/$(database)/documents/members/$(id); }
    function swapPath(id)    { return /databases/$(database)/documents/swaps/$(id); }
    function machinePath()   { return /databases/$(database)/documents/config/machine; }

    // The day key ("YYYY-MM-DD") must be the date of startMs in Israel (UTC+2 in winter, UTC+3 in summer).
    function isDateOf(day, ms) {
      let p = day.split('-');
      let t = timestamp.value(ms);
      return int(p[0]) == t.year() && int(p[1]) == t.month() && int(p[2]) == t.day();
    }
    function isIsraelDay(day, ms) {
      return isDateOf(day, ms + 7200000) || isDateOf(day, ms + 10800000);
    }

    function machineOk() {
      return !exists(machinePath()) || get(machinePath()).data.broken != true;
    }

    // The page reads this only to find out whether the viewer is the admin.
    match /adminCheck/{doc} {
      allow read: if isAdmin();
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sign-up details. Visible to everyone using the page (so people can call each other).
    // The admin can edit anyone, and add neighbours who don't use the app (ids starting "manual_").
    match /members/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.auth.uid == uid || isAdmin())
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'joinedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && (request.resource.data.email == '' || request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'))
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9 && request.resource.data.phone.size() <= 25;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // A turn. Its id is its start time in milliseconds; turns start on a 15-minute grid and last 45 minutes.
    // Creating one must, in the same write, claim its three 15-minute "ticks" (so turns can't overlap)
    // and the person's "daily" document for that day (so it's one turn per person per day).
    match /bookings/{id} {
      allow read: if true;

      // A turn is valid when it sits on the 15-minute grid, carries the Israel date of its start,
      // and claims its owner's daily doc and its three ticks in the same write.
      function claimsSlot(d) {
        return d.keys().hasOnly(['uid', 'startMs', 'endMs', 'day', 'createdAt'])
          && exists(memberPath(d.uid))
          && d.startMs is int
          && id == string(d.startMs)
          && d.startMs % 900000 == 0
          && d.endMs == d.startMs + 2700000
          && d.startMs > request.time.toMillis() - 900000
          && d.startMs < request.time.toMillis() + 15 * 86400000
          && d.day is string
          && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && isIsraelDay(d.day, d.startMs)
          && getAfter(dailyPath(d.uid + '_' + d.day)).data.booking == id
          && getAfter(tickPath(string(d.startMs))).data.booking == id
          && getAfter(tickPath(string(d.startMs + 900000))).data.booking == id
          && getAfter(tickPath(string(d.startMs + 1800000))).data.booking == id;
      }

      // People book for themselves while the machine works; the admin can book for any member.
      allow create: if signedIn() && claimsSlot(request.resource.data)
        && ((request.resource.data.uid == request.auth.uid && machineOk()) || isAdmin());

      // "My laundry is out": the owner records when they finished, once.
      function isDone() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doneAt'])
          && !('doneAt' in resource.data)
          && (resource.data.uid == request.auth.uid || isAdmin())
          && request.resource.data.doneAt is int
          && request.resource.data.doneAt >= resource.data.startMs
          && request.resource.data.doneAt <= resource.data.endMs;
      }

      // Accepting a swap: the person asked flips the owners of both turns, in the same write
      // that marks the request accepted (so nobody can take one turn without giving the other).
      function isSwap() {
        let sw = get(swapPath(request.resource.data.swap));
        let newUid = request.resource.data.uid;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'swap'])
          && sw.data.status == 'pending'
          && sw.data.toUid == request.auth.uid
          && getAfter(swapPath(request.resource.data.swap)).data.status == 'accepted'
          && getAfter(bookingPath(sw.data.fromBooking)).data.uid == sw.data.toUid
          && getAfter(bookingPath(sw.data.toBooking)).data.uid == sw.data.fromUid
          && resource.data.startMs > request.time.toMillis()
          && ((sw.data.fromBooking == id && resource.data.uid == sw.data.fromUid && newUid == sw.data.toUid)
            || (sw.data.toBooking == id && resource.data.uid == sw.data.toUid && newUid == sw.data.fromUid))
          && getAfter(dailyPath(newUid + '_' + resource.data.day)).data.booking == id;
      }

      // Admin gives a future turn to someone else (same start time, so same id).
      // Moving a turn to another time is a delete plus a create.
      function isAdminEdit() {
        return isAdmin() && !('doneAt' in resource.data)
          && resource.data.startMs > request.time.toMillis()
          && claimsSlot(request.resource.data);
      }

      allow update: if signedIn() && (isDone() || isSwap() || isAdminEdit());
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // One document per 15 minutes of machine time. Created only together with its turn.
    match /ticks/{t} {
      allow read: if true;

      function tickOwnedByNewBooking(b) {
        let bk = getAfter(bookingPath(b));
        return (bk.data.uid == request.auth.uid || isAdmin())
          && (int(t) == bk.data.startMs
            || int(t) == bk.data.startMs + 900000
            || int(t) == bk.data.startMs + 1800000);
      }
      function tickFreed(b) {
        let bk = getAfter(bookingPath(b));
        return ('doneAt' in bk.data) && int(t) >= bk.data.doneAt;
      }

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['booking'])
        && tickOwnedByNewBooking(request.resource.data.booking);
      // Admin moving a turn: a tick passes to the new turn only if its old turn is gone (or is the same turn).
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['booking'])
        && tickOwnedByNewBooking(request.resource.data.booking)
        && (resource.data.booking == request.resource.data.booking
          || !existsAfter(bookingPath(resource.data.booking)));
      allow delete: if signedIn() && (resource == null
        || isAdmin()
        || !existsAfter(bookingPath(resource.data.booking))
        || tickFreed(resource.data.booking));
    }

    // "<uid>_<day>": the one turn this person has on that day.
    match /daily/{d} {
      allow read: if true;

      function dailyValid() {
        let bk = getAfter(bookingPath(request.resource.data.booking));
        return request.resource.data.keys().hasOnly(['uid', 'day', 'booking'])
          && d == request.resource.data.uid + '_' + request.resource.data.day
          && bk.data.uid == request.resource.data.uid
          && bk.data.day == request.resource.data.day;
      }
      // The turn it points to is gone or now belongs to someone else.
      function dailyStale() {
        return !existsAfter(bookingPath(resource.data.booking))
          || getAfter(bookingPath(resource.data.booking)).data.uid != resource.data.uid;
      }

      allow create: if signedIn() && dailyValid();
      allow update: if signedIn() && dailyValid() && dailyStale();
      allow delete: if signedIn() && (resource == null || isAdmin() || dailyStale());
    }

    // Swap requests: only the two people involved (and the admin) can see them.
    match /swaps/{s} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'fromBooking', 'toBooking', 'status', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && get(bookingPath(request.resource.data.fromBooking)).data.uid == request.auth.uid
        && get(bookingPath(request.resource.data.toBooking)).data.uid == request.resource.data.toUid;
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answeredAt'])
        && (request.resource.data.status == 'declined'
          || (request.resource.data.status == 'accepted'
            && getAfter(bookingPath(resource.data.fromBooking)).data.uid == resource.data.toUid
            && getAfter(bookingPath(resource.data.toBooking)).data.uid == resource.data.fromUid));
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isAdmin());
    }

    // Email reminder setting: private to each person.
    match /prefs/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'lang', 'updatedAt'])
        && request.resource.data.email is bool;
    }

    // "Reminder already sent" markers: written only by the reminder function, which bypasses these rules.
    match /reminders/{id} {
      allow read, write: if false;
    }
  }
}
