rules_version = '2';
// TEST-ONLY stand-in rules for the multi-user emulator tests.
// These are NOT the production rules (those live only in the Firebase console).
// They encode what the app expects the rules to enforce, so the tests can check
// the app's writes are accepted and that cheating writes are refused.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email in ['admin@example.com'];
    }
    function bookingDoc(id) { return /databases/$(database)/documents/bookings/$(id); }
    function tickDoc(ms) { return /databases/$(database)/documents/ticks/$(ms); }
    function dailyDoc(key) { return /databases/$(database)/documents/daily/$(key); }
    function swapDoc(id) { return /databases/$(database)/documents/swaps/$(id); }
    function isMember(uid) { return exists(/databases/$(database)/documents/members/$(uid)); }
    function isBroken() {
      return exists(/databases/$(database)/documents/config/machine) && get(/databases/$(database)/documents/config/machine).data.broken == true;
    }
    function bAfter(id) { return getAfter(bookingDoc(id)).data; }
    // The booking was handed over by a swap that the signed-in user accepted in this same batch.
    function swapByMe(b) {
      return 'swap' in b
        && getAfter(swapDoc(b.swap)).data.toUid == request.auth.uid
        && getAfter(swapDoc(b.swap)).data.status == 'accepted';
    }

    match /adminCheck/{id} { allow read: if isAdmin(); }

    match /config/machine {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /members/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'joinedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 25;
      allow delete: if isAdmin();
    }

    match /prefs/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /reminders/{id} { allow read, write: if false; }

    match /bookings/{id} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && isMember(request.auth.uid) && !isBroken()
        && request.resource.data.keys().hasOnly(['uid', 'startMs', 'endMs', 'day', 'createdAt'])
        && request.resource.data.startMs is int
        && id == string(request.resource.data.startMs)
        && request.resource.data.startMs % 900000 == 0
        && request.resource.data.endMs == request.resource.data.startMs + 2700000
        && request.resource.data.startMs > request.time.toMillis() - 600000
        && request.resource.data.startMs < request.time.toMillis() + 15 * 86400000
        && getAfter(tickDoc(string(request.resource.data.startMs))).data.booking == id
        && getAfter(tickDoc(string(request.resource.data.startMs + 900000))).data.booking == id
        && getAfter(tickDoc(string(request.resource.data.startMs + 1800000))).data.booking == id
        && getAfter(dailyDoc(request.resource.data.uid + '_' + request.resource.data.day)).data.booking == id;

      allow update: if signedIn() && (
        // "My laundry is out"
        (resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doneAt'])
          && request.resource.data.doneAt is int)
        ||
        // accepting a swap moves both bookings in one batch
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'swap'])
          && swapMoves(id))
      );

      function swapMoves(id) {
        let sw = getAfter(swapDoc(request.resource.data.swap)).data;
        let before = get(swapDoc(request.resource.data.swap)).data;
        return before.status == 'pending' && sw.status == 'accepted' && sw.toUid == request.auth.uid
          && resource.data.startMs > request.time.toMillis()
          && ((id == sw.fromBooking && resource.data.uid == sw.fromUid && request.resource.data.uid == sw.toUid)
           || (id == sw.toBooking && resource.data.uid == sw.toUid && request.resource.data.uid == sw.fromUid))
          && getAfter(dailyDoc(request.resource.data.uid + '_' + resource.data.day)).data.booking == id;
      }

      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // One doc per 15-minute block. Create-only, so a second booking over the same block is refused.
    match /ticks/{t} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['booking'])
        && bAfter(request.resource.data.booking).uid == request.auth.uid
        && int(t) >= int(request.resource.data.booking)
        && int(t) < int(request.resource.data.booking) + 2700000;
      allow update: if false;
      allow delete: if signedIn() && (isAdmin()
        || !exists(bookingDoc(resource.data.booking))
        || get(bookingDoc(resource.data.booking)).data.uid == request.auth.uid);
    }

    // One doc per person per day.
    match /daily/{key} {
      allow read: if signedIn();
      function validDaily() {
        let d = request.resource.data;
        let b = bAfter(d.booking);
        return key == d.uid + '_' + d.day && d.keys().hasOnly(['uid', 'day', 'booking'])
          && b.uid == d.uid && b.day == d.day;
      }
      // The doc it replaces must point to a booking that is gone or no longer theirs.
      function replacedIsStale() {
        return !existsAfter(bookingDoc(resource.data.booking))
          || bAfter(resource.data.booking).uid != resource.data.uid;
      }
      allow create: if signedIn() && validDaily()
        && (request.resource.data.uid == request.auth.uid || swapByMe(bAfter(request.resource.data.booking)));
      allow update: if signedIn() && validDaily()
        && swapByMe(bAfter(request.resource.data.booking)) && replacedIsStale();
      allow delete: if signedIn() && (isAdmin() || replacedIsStale());
    }

    match /swaps/{id} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && get(bookingDoc(request.resource.data.fromBooking)).data.uid == request.auth.uid
        && get(bookingDoc(request.resource.data.toBooking)).data.uid == request.resource.data.toUid;
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answeredAt'])
        && (request.resource.data.status == 'declined'
          || (request.resource.data.status == 'accepted' && bAfter(resource.data.fromBooking).swap == id));
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isAdmin());
    }
  }
}
